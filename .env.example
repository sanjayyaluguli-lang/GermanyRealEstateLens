# PostgreSQL in an EU region (e.g. Neon eu-central-1, Supabase Frankfurt, Railway EU, Scaleway, Hetzner).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grelens

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this key makes stored financial data unreadable — back it up securely.
ENCRYPTION_KEY=

# Public base URL, used in e-mailed links.
APP_URL=http://localhost:3000

# SMTP for password-reset and magic-link mails (use an EU provider).
# Optional in development: links are printed to the server console instead.
SMTP_URL=
MAIL_FROM="GermanyRealEstateLens <no-reply@example.de>"

# Shown as the controller in the privacy policy.
NEXT_PUBLIC_OPERATOR_CONTACT="Max Mustermann, Musterstraße 1, 10115 Berlin, datenschutz@example.de"
